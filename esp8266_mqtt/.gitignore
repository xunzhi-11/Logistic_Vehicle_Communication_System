# ESP8266 RTOS SDK 项目 .gitignore 文件

# 构建产物
build/
*.o
*.d
*.elf
*.map
*.bin
*.hex
*.a

# SDK 配置（通常不提交，除非是默认配置）
sdkconfig
sdkconfig.old
sdkconfig.ci

# IDE 和编辑器文件
.vscode/
*.swp
*.swo
*~

# 临时文件
*.tmp
*.bak
*.log

# Python 缓存（如果有 Python 脚本）
__pycache__/
*.pyc
*.pyo

# 系统文件
.DS_Store
Thumbs.db

# 其他常见忽略项
*.zip
*.tar.gz
*.7z